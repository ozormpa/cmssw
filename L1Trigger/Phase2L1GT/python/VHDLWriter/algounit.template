library IEEE;
use IEEE.STD_LOGIC_1164.all;
use IEEE.NUMERIC_STD.all;

use work.emp_data_types.all;
use work.emp_project_decl.all;

use work.common_pkg.all;
use work.object_defs.all;


entity p2gt_algos_slr{{slrnumber}} is
  generic (
    cut_offset     : natural := 0;
    algobit_offset : natural := 0
  );
  port (
    clk_algo        : in  std_logic;
    rst_algo        : in  std_logic;
    objects_valid   : in  std_logic;
    objects         : in  t_object_map;
    algo_bits_valid : out std_logic;
    algo_bits       : out std_logic_vector(NUM_TOTAL_ALGOS - 1 downto 0) := (others => '0')
  );

end p2gt_algos_slr{{slrnumber}};

architecture rtl of p2gt_algos_slr{{slrnumber}} is
  signal algo_bits_int : std_logic_vector(NUM_TOTAL_ALGOS - 1 downto 0) := (others => '0');
  signal delayed_valid_buffer : std_logic_vector(ALGO_UNIT_LATENCY downto 0);
  signal objects_bx : t_delayed_collection_map(INTER_BX_RANGE)(t_collection);
  signal objects_valid_bx : t_delayed_valid_vector(INTER_BX_RANGE);

  -------- SIGNALS ---------
  {% for key,value in filtermodules.items() %}
  signal {{key}}_result : std_logic := '0';
  {% for val in value.Paths %}
  signal {{val}} : std_logic := '0';
  {% endfor %}
  {% endfor %}
  -------- SIGNALS end ---------

begin

  inter_bx_delay : entity work.p2gt_interBXDelay
      port map(
        clk_algo        => clk_algo,
        rst_algo        => rst_algo,
        objects_valid   => objects_valid,
        objects         => objects,
        delayed_objects => objects_bx,
        delayed_valid   => objects_valid_bx
      );

  process (clk_algo)
  begin
    if rising_edge(clk_algo) then
      delayed_valid_buffer <= delayed_valid_buffer(delayed_valid_buffer'high - 1 downto 0) & objects_valid;
    end if;
  end process;

  -------- ALGORITHMS ---------- 
  {{Conditions | indent(2)}}
  -------- ALGORITHMS end ---------- 
    
  -------- ASSOCIATE PATHS WITH CONDDITIONS  --------
  {% for key,value in filtermodules.items() %}
  {% for val in value.Paths %}
  {{val}} <= {{key}}_result;
  {% endfor %}
  {% endfor %}


  -------- ASSOCIATE PATHS WITH Conditions  end --------

  -------- OUTPUT ALGO BITS --------

  {% for key,value in algobits.items() %}
  {% for values in filtermodules.values() %}
  {% for val in values.Paths %}
  {% if val in value.expression %}
  algo_bits_int({{key}}) <= {{value.expression}};
  {% endif %}
  {% endfor %}
  {% endfor %}
  {% endfor %}

  reg_outputs : process (clk_algo) -- Register on algo clk for one BX
  begin
    if rising_edge(clk_algo) then
      algo_bits <= algo_bits_int;
    end if;
  end process;

  -------- OUTPUT ALGO BITS end--------
  algo_bits_valid <= delayed_valid_buffer(delayed_valid_buffer'high);

end rtl;

